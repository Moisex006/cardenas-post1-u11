<!-- src/main/resources/logback-spring.xml -->
<configuration>
  <!-- Consola: formato corto para desarrollo -->
  <appender name="CONSOLA" class="ch.qos.logback.core.ConsoleAppender">
    <encoder>
      <pattern>%d{HH:mm:ss} %-5level %logger{30} - %msg%n</pattern>
    </encoder>
  </appender>

  <!-- Archivo: rotación diaria y 30 días de historial -->
  <appender name="ARCHIVO"
            class="ch.qos.logback.core.rolling.RollingFileAppender">
    <file>logs/pedidos.log</file>
    <rollingPolicy
        class="ch.qos.logback.core.rolling.TimeBasedRollingPolicy">
      <fileNamePattern>logs/pedidos.%d{yyyy-MM-dd}.log</fileNamePattern>
      <maxHistory>30</maxHistory>
    </rollingPolicy>
    <encoder>
      <pattern>%d{yyyy-MM-dd HH:mm:ss} %-5level %logger - %msg%n</pattern>
    </encoder>
  </appender>

  <logger name="com.tienda.pedidos" level="DEBUG"/>

  <root level="INFO">
    <appender-ref ref="CONSOLA"/>
    <appender-ref ref="ARCHIVO"/>
  </root>
</configuration>
